---
import Base from '../layouts/Base.astro';
import Footprint from '../components/Footprint.astro';

// Every Groundwork chapter, deep-linked. Groundwork opens on the chapter named in
// the hash, so these land the reader exactly where they need to be.
const chapters = [
  { id: 'start',         n: '01', title: 'Start Here',              blurb: 'Two doors: something for my client, or something for me.' },
  { id: 'ethics',        n: '02', title: 'Foundations & Ethics',    blurb: 'NASW core values, and dual relationships in small towns.' },
  { id: 'theories',      n: '03', title: 'Theories & Modalities',   blurb: 'Why people behave the way they do, and what you actually do in session.' },
  { id: 'groups',        n: '04', title: 'Groups',                  blurb: 'Session structure, group dynamics, and plans you can run this week.' },
  { id: 'assessment',    n: '05', title: 'Assessment Cheat Sheets', blurb: 'PHQ-9, GAD-7, PCL-5, AUDIT, EPDS, MDQ, scored on the spot.' },
  { id: 'crisis',        n: '06', title: 'Crisis & Safety',         blurb: 'Suicide risk, emergency detention, reporting, duty to warn.' },
  { id: 'documentation', n: '07', title: 'Documentation',           blurb: 'SOAP notes, objective language, corrections, consent, discharge.' },
  { id: 'wellbeing',     n: '08', title: 'Clinician Wellbeing',     blurb: 'Vicarious trauma, compassion fatigue, and what actually helps.' },
  { id: 'trainings',     n: '09', title: 'Trainings',               blurb: 'Free CE that Texas actually accepts, and what it requires.' },
  { id: 'licensure',     n: '10', title: 'Licensure',               blurb: 'Every Texas exam and fee, in the order they happen.' },
  { id: 'supervision',   n: '11', title: 'Supervision & Practicum', blurb: 'Which supervision counts, your protections, what voids hours.' },
  { id: 'practice',      n: '12', title: 'Private Practice',        blurb: 'Who can open one, the setup checklist, software, credentialing.' },
  { id: 'resources',     n: '13', title: 'Client Resources',        blurb: 'Food, housing, bills, ID, health care, and the Texas shelter directory.' },
  { id: 'printables',    n: '14', title: 'Printables',              blurb: 'Feelings wheel, circle of control, grounding, group worksheets.' },
  { id: 'glossary',      n: '15', title: 'Glossary',                blurb: 'Field vocabulary, quick definitions.' },
];
---
<Base
  title="The Grounded Elephant"
  description="A home for practical, verified clinical tools for social workers and counselors, starting with Groundwork, a working reference for direct practice.">

  <section class="hero">
    <div class="hero-art" aria-hidden="true">
      <!-- The pencil animation. Its white background is blended away: multiply on
           light paper, invert+screen on dark. People who prefer reduced motion get
           the still instead. -->
      <div class="hero-crop">
        <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/brand/lockup-light.png">
          <source src="/brand/grounded-elephant.mp4" type="video/mp4" />
        </video>
      </div>
      <img class="hero-still only-light" src="/brand/lockup-light.png" alt="" width="1000" height="672" />
      <img class="hero-still only-dark" src="/brand/lockup-dark.png" alt="" width="1000" height="672" />
    </div>
    <p class="kicker">Clinical tools, built by a clinician</p>
    <h1 class="visually-hidden">The Grounded Elephant</h1>
    <p class="lede">
      Practical, verified tools for social workers and counselors who need the answer now, not the lecture.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/groundwork/"><Footprint size={17} /><span>Lay the Groundwork</span></a>
      <a class="btn" href="/about/">Read my story</a>
    </div>
  </section>

  <section class="feature">
    <p class="kicker">The reference</p>
    <h2>Groundwork</h2>
    <p>
      A working reference for direct practice. The theories under the work, the modalities used in session,
      screeners you can score on the spot, group plans you can run this week, printable handouts, Texas
      licensing and supervision rules cited by number, and a filterable resource directory with phone numbers
      that actually connect.
    </p>
    <ul class="feature-list">
      <li>Fifteen sections, searchable across all of them at once</li>
      <li>Every rule badged <strong>Texas</strong> or <strong>National</strong>, so nobody gets caught by a rule that isn't theirs</li>
      <li>Verified against primary sources, with the date of the last check on every page</li>
      <li>Prints clean. Works on a phone. No login, no tracking, no client data ever touches it</li>
    </ul>
    <a class="btn btn-primary" href="/groundwork/"><Footprint size={17} /><span>Lay the Groundwork</span></a>
  </section>

  <section class="chapters" aria-labelledby="chapters-h">
    <p class="kicker">Inside Groundwork</p>
    <h2 id="chapters-h">Fifteen sections. Jump straight to one.</h2>
    <div class="chapter-grid">
      {chapters.map(c => (
        <a class="chapter" href={`/groundwork/#${c.id}`}>
          <span class="chapter-n">{c.n}</span>
          <span class="chapter-t">{c.title}</span>
          <span class="chapter-b">{c.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="strip">
    <div class="strip-item">
      <h3>For the moment, not the semester</h3>
      <p>Built for the hallway between sessions, the intake that just took a turn, the Friday group you still have to plan.</p>
    </div>
    <div class="strip-item">
      <h3>Honest about what it is</h3>
      <p>A reference, not a substitute for supervision, your agency, or your board. If those disagree with something here, they win.</p>
    </div>
    <div class="strip-item">
      <h3>Made in the Hill Country</h3>
      <p>Started as one practicum student's cheat sheet at a domestic violence shelter. Grew because other clinicians asked for it.</p>
    </div>
  </section>
</Base>

<style>
  .kicker{font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--wine); margin:0 0 8px;}
  .hero{padding:24px 0 48px;}
  .hero-art{width:100%; max-width:560px; margin:0 0 10px;}
  /* The clip has a lot of empty paper around the drawing. Measured over every frame,
     the ink spans x 21-78% and y 25-69% of the frame; this window shows x 18-81%
     and y 22-72%, so nothing is cut off at any point in the loop. */
  .hero-crop{position:relative; overflow:hidden; aspect-ratio:63 / 50;}
  .hero-video{position:absolute; display:block; width:158.73%; height:auto; left:-28.57%; top:-44%; mix-blend-mode:multiply; filter:contrast(1.3) brightness(1.12);}
  .hero-still{width:100%; height:auto;}
  /* Video is the default. The stills only take over when motion is reduced; the
     selectors are deliberately specific so they outrank the theme utility. */
  .hero-art .hero-still.only-light, .hero-art .hero-still.only-dark{display:none;}
  @media (prefers-reduced-motion: reduce){
    .hero-art .hero-video{display:none;}
    .hero-art .hero-still.only-light{display:block;}
    @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .hero-art .hero-still.only-light{display:none;} :root:not([data-theme="light"]) .hero-art .hero-still.only-dark{display:block;} }
    :root[data-theme="dark"] .hero-art .hero-still.only-light{display:none;}
    :root[data-theme="dark"] .hero-art .hero-still.only-dark{display:block;}
  }
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .hero-video{filter:contrast(1.3) brightness(1.12) invert(1) hue-rotate(180deg); mix-blend-mode:screen;} }
  :root[data-theme="dark"] .hero-video{filter:contrast(1.3) brightness(1.12) invert(1) hue-rotate(180deg); mix-blend-mode:screen;}
  .visually-hidden{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap;}
  .hero h1{font-family:var(--font-display); font-size:clamp(2.2rem,5vw,3.4rem); line-height:1.1; margin:0 0 14px; letter-spacing:-0.01em;}
  .hero h1::after{content:""; display:block; width:64px; height:4px; border-radius:99px; margin-top:16px;
                  background:linear-gradient(90deg, var(--pine), var(--wine));}
  .lede{font-size:1.15rem; color:var(--ink-soft); max-width:56ch; margin:0 0 22px;}
  .cta-row{display:flex; gap:10px; flex-wrap:wrap;}
  /* On a phone the drawing fills the width and left-aligned text reads best. On
     wider screens the hero would sit off to the left, so it centers from 720px up. */
  @media (min-width: 720px){
    .hero{display:flex; flex-direction:column; align-items:center; text-align:center;}
    .hero-art{margin:0 auto 10px;}
    .lede{margin:0 auto 22px;}
    .cta-row{justify-content:center;}
  }
  .btn{display:inline-flex; align-items:center; gap:8px; text-decoration:none; font-weight:600; font-size:0.92rem; padding:11px 18px; border-radius:99px;
       border:1px solid var(--line); color:var(--ink); background:var(--paper-raised); box-shadow:var(--shadow);}
  .btn:hover{transform:translateY(-1px);}
  .btn-primary{background:var(--pine); border-color:var(--pine); color:var(--on-accent);}
  .feature{background:var(--paper-raised); border:1px solid var(--line); border-left:5px solid var(--pine);
           border-radius:var(--radius); padding:30px clamp(20px,4vw,40px); box-shadow:var(--shadow); margin:0 0 36px;}
  .feature h2{font-family:var(--font-display); font-size:1.8rem; margin:0 0 10px;}
  .feature p{margin:0 0 14px;}
  .feature-list{margin:0 0 20px; padding-left:20px;}
  .feature-list li{margin:6px 0;}
  .chapters{margin:0 0 40px;}
  .chapters h2{font-family:var(--font-display); font-size:1.5rem; margin:0 0 16px;}
  .chapter-grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(230px,1fr)); gap:10px;}
  .chapter{display:flex; flex-direction:column; gap:3px; text-decoration:none; color:var(--ink);
           background:var(--paper-raised); border:1px solid var(--line); border-left:3px solid var(--pine);
           border-radius:var(--radius); padding:14px 15px 13px; box-shadow:var(--shadow);
           transition:transform .15s ease, border-color .15s ease;}
  .chapter:hover{transform:translateY(-2px); border-left-color:var(--wine);}
  .chapter-n{font-family:var(--font-mono); font-size:0.7rem; color:var(--ink-soft);}
  .chapter-t{font-weight:600; font-size:0.95rem; line-height:1.3;}
  .chapter-b{font-size:0.8rem; color:var(--ink-soft); line-height:1.45;}
  .strip{display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:14px;}
  .strip-item{padding:18px 20px; border:1px solid var(--line); border-radius:var(--radius); background:var(--paper-raised);}
  .strip-item h3{font-family:var(--font-display); font-size:1.05rem; margin:0 0 6px;}
  .strip-item p{margin:0; font-size:0.9rem; color:var(--ink-soft);}
</style>
