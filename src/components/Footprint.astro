---
// The elephant footprint on "Lay the Groundwork" buttons: one round pad with four
// toenails riding its top rim, drawn as a loose pencil line to match the logo.
// Takes its color from the button text. Small sizes get a heavier line.
interface Props { size?: number; }
const { size = 18 } = Astro.props;
const w = size <= 20 ? 4.6 : size <= 32 ? 4.0 : 3.5;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width={w} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block; flex-shrink:0">
  <path d="M 21 22 C 12 27, 10 43, 19 52 C 28 61, 46 59, 52 48 C 57 38, 52 24, 40 20 C 33 18, 26 19, 20.5 23"/>
  <path d="M 14.5 25 C 12 20.5, 16.5 16, 20.5 18.5 C 23 20, 22.5 24, 19.5 25"/>
  <path d="M 24 18.5 C 23.5 13, 30 11, 32.5 15 C 34 17.5, 32 21, 28.5 20"/>
  <path d="M 35.5 16 C 37 11.5, 43.5 12, 43.5 16.5 C 43.5 19.5, 40 21.5, 37.5 19.5"/>
  <path d="M 45.5 21 C 49 18, 54 21.5, 52 25.5 C 50.5 28, 47 27.5, 46 25"/>
</svg>
